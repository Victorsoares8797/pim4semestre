<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove=".local/**" />
    <None Remove=".local/**" />
    <None Update="supabase-ca.crt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublicarSiteHtml" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <SiteHtml Include="../site-pim3/**/*" Exclude="../site-pim3/README.md" />
      <ResolvedFileToPublish Include="@(SiteHtml)">
        <RelativePath>wwwroot/%(SiteHtml.RecursiveDir)%(SiteHtml.Filename)%(SiteHtml.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
